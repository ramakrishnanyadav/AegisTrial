{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CriteriaExtractionOutput",
  "type": "object",
  "required": ["criteria"],
  "additionalProperties": false,
  "properties": {
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterionId", "type", "field", "operator", "threshold", "unit", "sourceRef"],
        "additionalProperties": false,
        "properties": {
          "criterionId": { "type": "string", "pattern": "^(IC|EC|AMB)-[0-9]{2,4}$" },
          "type": { "type": "string", "enum": ["INCLUSION", "EXCLUSION", "AMBIGUOUS"] },
          "field": { "type": "string", "minLength": 1 },
          "operator": { "type": "string", "enum": [">=", "<=", ">", "<", "==", "!=", "IN", "NOT_IN", "PRESENT", "ABSENT"] },
          "threshold": {},
          "unit": { "type": "string" },
          "temporalWindow": { "type": "string" },
          "sourceRef": {
            "type": "object",
            "required": ["docId", "textExcerpt"],
            "properties": {
              "docId": { "type": "string" },
              "page": { "type": "number" },
              "paragraph": { "type": "string" },
              "textExcerpt": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    }
  }
}
