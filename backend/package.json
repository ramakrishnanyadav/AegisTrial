{
  "name": "aegistrial-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --testPathPattern=tests --forceExit",
    "test:invariants": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --testPathPattern=tests/invariants --forceExit",
    "test:phi": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --testPathPattern=tests/phi --forceExit",
    "migrate": "tsx src/db/migrator.ts",
    "benchmark": "tsx scripts/runBenchmark.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "better-sqlite3": "^11.5.0",
    "compromise": "^14.14.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^13.4.0",
    "pdf-lib": "^1.17.1",
    "unorm": "^1.6.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
