{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@engine/*": ["./src/engine/*"],
      "@phi/*": ["./src/phi/*"],
      "@lyzr/*": ["./src/lyzr/*"],
      "@aims/*": ["./src/aims/*"],
      "@auth/*": ["./src/auth/*"],
      "@db/*": ["./src/db/*"],
      "@audit/*": ["./src/audit/*"],
      "@api/*": ["./src/api/*"]
    }
  },
  "include": ["src/**/*", "../shared/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
