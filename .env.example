# =============================================================================
# AegisTrial v4 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to source control.
# =============================================================================

# --- Lyzr Agent API -----------------------------------------------------------
# Required. Get your API key from https://studio.lyzr.ai
LYZR_API_KEY=

# Agent IDs — auto-populated by backend/src/lyzr/provision.ts on first startup.
# If you provision agents manually via Lyzr Studio, paste the IDs here.
LYZR_CRITERIA_AGENT_ID=
LYZR_EVIDENCE_AGENT_ID=
LYZR_SAFETY_AGENT_ID=
LYZR_ONTOLOGY_AGENT_ID=
LYZR_DOSSIER_AGENT_ID=

# --- Firebase (existing) ------------------------------------------------------
FIREBASE_PROJECT_ID=guardagent-d49b6
# Firebase Admin SDK service account JSON, base64-encoded.
# Generate: gcloud iam service-accounts keys create key.json --iam-account=...
# Encode:   base64 -i key.json (macOS/Linux) or [Convert]::ToBase64String([IO.File]::ReadAllBytes('key.json')) (PowerShell)
FIREBASE_ADMIN_KEY_JSON=

# --- AIMS Integration ---------------------------------------------------------
# Leave empty to use the built-in simulated AIMS-compatible event sink at
# /api/aims/_mock. This is a local demo endpoint — NOT an FDA system.
# Set to an external AIMS-compatible event sink URL for real integration.
# DO NOT use any real aims.fda.gov URL — this project does not claim
# or implement actual FDA AIMS integration.
AIMS_ENDPOINT=

# Set to "true" to simulate an AIMS 503 outage for Attack 6 demo.
# The local screening will still complete (screeningStatus=COMPLETED).
# The outbox row will be PENDING (aimsDeliveryStatus=PENDING).
AIMS_SIMULATE_503=false

# --- Existing Gemini / App (legacy frontend features) -------------------------
GEMINI_API_KEY=
APP_URL=

# --- OAuth (existing) ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Note: GitHub PAT verification has been removed from the auth surface.
# GitHub OAuth popup (signInWithPopup + GithubAuthProvider) is still supported.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
