rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & credentials (Field-scoped RBAC protection)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow create: if isOwner(userId)
        && !('role' in request.resource.data)
        && !('institution' in request.resource.data)
        && !('npiNumber' in request.resource.data);
      allow delete: if false;
    }

    // Patient eligibility screenings (Backend Admin SDK writes only, client read-only)
    match /screenings/{screeningId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // 21 CFR Part 11 Audit Trail — Immutable log (Backend Admin SDK writes only)
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Adversarial benchmark testing results
    match /attack_benchmarks/{benchmarkId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Fallback default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
